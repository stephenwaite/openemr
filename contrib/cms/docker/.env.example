# Copy to .env next to docker-compose.yml and fill in. Keep .env out of git.

# The image to run, pinned to the build's commit, e.g.
# cmsvt/openemr:cms-rel-840-1a2b3c4d5e. Change it (and `docker compose up -d`)
# to move to a new build or back to an older one. Unset: the latest local
# cmsvt/openemr:cms-rel-840.
CMS_IMAGE=

# The sites folder to run from: relative to this directory or absolute.
# Dry run: ../sites. Production: the migrated copy of the 7.0.1 sites folder.
CMS_SITES_DIR=../sites

# MariaDB root password. Only read when the database volume is first
# created; changing it later needs `down -v`.
CMS_DB_ROOT_PASS=

# Leave this unset. Pass it only for the first start of a new stock
# `default`, which needs root to create its database:
#   CMS_SETUP_DB_ROOT_PASS=<root password> docker compose up -d
# then, once the log shows "Setup Complete!", run `docker compose up -d`
# again without it, so the running container has no root password.
#CMS_SETUP_DB_ROOT_PASS=

# The stock `default` site's database password and admin password (used
# only where `default` isn't a real site and is configured as a new one).
CMS_DEFAULT_DB_PASS=
CMS_DEFAULT_ADMIN_PASS=

# Let's Encrypt: this server's hostname (its DNS must point here, and port 80
# must be reachable from the internet) and the address for expiry notices.
# Leave both empty for a self-signed certificate (dry runs).
CMS_DOMAIN=
CMS_LETSENCRYPT_EMAIL=

# Host ports. In a Docker Sandbox, also publish them on the host.
CMS_HTTP_PORT=80
CMS_HTTPS_PORT=443
