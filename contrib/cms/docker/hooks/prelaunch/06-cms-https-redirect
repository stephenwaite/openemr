#!/bin/bash
# Prelaunch hook (runs on every container start, before Apache).
#
# The image serves OpenEMR over plain HTTP on port 80 by default. This makes
# port 80 answer only Let's Encrypt's HTTP check (/.well-known/acme-challenge/)
# and redirect everything else to HTTPS, so the container can renew its
# certificate without an unencrypted way in.
set -euo pipefail

conf="${CMS_APACHE_CONF:-/etc/apache2/conf.d/openemr.conf}"
marker='# CMS: HTTP only for the Let'"'"'s Encrypt check; everything else to HTTPS'
https_port="${CMS_HTTPS_PORT:-443}"
if [[ ! "${https_port}" =~ ^[0-9]+$ ]]; then
    echo "cms https redirect: CMS_HTTPS_PORT must be a number" >&2
    exit 1
fi

if grep -qF "${marker}" "${conf}"; then
    echo "cms https redirect: already configured"
    exit 0
fi
if ! grep -q '^<VirtualHost \*:80>' "${conf}"; then
    echo "cms https redirect: no port 80 virtual host in ${conf}" >&2
    exit 1
fi

target='https://%{SERVER_NAME}'
if [[ "${https_port}" != "443" ]]; then
    target="${target}:${https_port}"
fi
tmp="$(mktemp)"
awk -v marker="${marker}" -v target="${target}" '
    { print }
    /^<VirtualHost \*:80>/ {
        print "    " marker
        print "    RewriteEngine On"
        print "    RewriteCond %{REQUEST_URI} !^/\\.well-known/acme-challenge/"
        print "    RewriteRule ^ " target "%{REQUEST_URI} [R=301,L]"
    }
' "${conf}" > "${tmp}"
cat "${tmp}" > "${conf}"
rm -f "${tmp}"
echo "cms https redirect: port 80 redirects to ${target}"
