-- REPLACE INTO globals (gl_name, gl_index, gl_value) VALUES ('cmsvt_claim_rendering_provider_id', 0, '<users.id>');

-- Claims: closed service facility NPIs.
-- REPLACE INTO globals (gl_name, gl_index, gl_value) VALUES ('cmsvt_claim_closed_facility_npis', 0, '<npi>');

