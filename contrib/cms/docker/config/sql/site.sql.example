-- Template for a site's own settings. Copy to <site>.sql, where <site> is the
-- site's directory name under sites/, keep only the settings that site used
-- in production (DEPLOYMENT.md section 3), fill in the values and uncomment.
-- The prelaunch settings hook applies each <site>.sql once to that site.
-- Keep the real files out of git: they identify the sites.

-- Billing Manager: default to the last N months of service dates.
-- REPLACE INTO globals (gl_name, gl_index, gl_value) VALUES ('cmsvt_billing_manager_dos_months', 0, '<months>');

-- Eligibility (270): a fixed provider and receiver name. Confirm the user's
-- NPI matches.
-- REPLACE INTO globals (gl_name, gl_index, gl_value) VALUES ('cmsvt_elig_provider_id', 0, '<users.id>');
-- REPLACE INTO globals (gl_name, gl_index, gl_value) VALUES ('cmsvt_elig_receiver_name', 0, '<receiver name>');

-- Collections report: hide Export to Collections (agency).
-- REPLACE INTO globals (gl_name, gl_index, gl_value) VALUES ('cmsvt_collections_hide_agency_export', 0, '1');

-- Claims: payers that get no NDCs, and the user to bill under.
