{% macro status(value) %}
    {%- set css = value starts with 'Not Reported' ? 'text-danger font-italic'
        : value starts with 'Exception' ? 'text-warning font-weight-bold'
        : (value starts with 'Not Met' or value starts with 'Recurrence') ? 'text-danger font-weight-bold'
        : 'text-success font-weight-bold' -%}
    <span class="{{ css|attr }}">{{ value|text }}</span>
{%- endmacro %}
{% macro list(entries) %}
    {%- if entries is empty %}<span class="text-muted">&mdash;</span>{% else %}{% for entry in entries %}{{ entry|text }}{% if not loop.last %}<br />{% endif %}{% endfor %}{% endif -%}
{% endmacro %}
{% macro patientLink(pid) %}
    <a href="#" class="font-weight-bold" onclick="return goPid({{ pid|js_escape|attr }});" title="{{ 'Open patient dashboard'|xla }}">{{ pid|text }}</a>
{%- endmacro %}
{% import _self as m %}
<html>
<head>
    <title>{{ 'MIPS 509 Melanoma: Tracking and Evaluation of Recurrence'|xlt }}</title>
    {{ setupHeader() }}
    <style>
        .codes { font-size: 0.85rem; white-space: nowrap; }
    </style>
    <script>
        function goPid(pid) {
            top.restoreSession();
            top.RTop.location = {{ (webroot ~ '/interface/patient_file/summary/demographics.php?set_pid=')|js_escape }} + encodeURIComponent(pid);
            return false;
        }
    </script>
</head>
<body class="body_top">
<div class="container-fluid">
<h4>{{ 'MIPS 509 Melanoma: Tracking and Evaluation of Recurrence'|xlt }}</h4>

<form method="get" class="form-inline mb-3" onsubmit="return top.restoreSession()">
    <label class="mr-2" for="form_year">{{ 'Performance Year'|xlt }}:</label>
    <select name="form_year" id="form_year" class="form-control mr-3" onchange="top.restoreSession(); this.form.submit();">
        {% for y in years %}
            <option value="{{ y|attr }}"{% if y == measure.year %} selected{% endif %}>{{ y|text }}</option>
        {% endfor %}
    </select>
    <a class="btn btn-primary btn-sm mr-2" href="?form_year={{ measure.year|attr_url }}&amp;export=csv" onclick="top.restoreSession()">{{ 'Export Encounter Detail to CSV'|xlt }}</a>
    <a class="btn btn-primary btn-sm" href="?form_year={{ measure.year|attr_url }}&amp;export=csv_tracking" onclick="top.restoreSession()">{{ 'Export Patient Tracking to CSV'|xlt }}</a>
</form>

<div class="border rounded bg-light p-3 mb-3">
    <div><strong>{{ 'Performance Period'|xlt }}:</strong> {{ measure.periodStart()|text }} {{ 'to{{Range}}'|xlt }} {{ measure.periodEnd()|text }}</div>
    <div><strong>{{ 'Diagnosis / Excision Lookback'|xlt }}:</strong> {{ measure.lookbackStart()|text }} {{ 'to{{Range}}'|xlt }} {{ measure.periodEnd()|text }}</div>
    <div class="mt-2">
        <strong>{{ 'Melanoma Patients'|xlt }}:</strong> {{ report.patients|length|text }}
        &nbsp;|&nbsp; <strong>{{ 'Denominator (qualifying visit)'|xlt }}:</strong> {{ report.denominatorCount()|text }}
        &nbsp;|&nbsp; <strong>{{ 'Qualifying Visits'|xlt }}:</strong> {{ report.encounterCount()|text }}
        &nbsp;|&nbsp; <strong>{{ 'Denominator Patients Without Excision CPT'|xlt }}:</strong> {{ report.missingExcisionCount()|text }}
    </div>
</div>

<div class="alert alert-warning">
    {{ 'Lists every living patient with a melanoma (C43) or melanoma in situ (D03) diagnosis billed in the lookback. Patients are in the denominator only if they also had a qualifying visit in the performance year; the criteria counts cover those patients only. Quality data codes count only in the performance year; excision CPTs are searched across the lookback. The diagnosis history also shows Z85.820 (personal history of melanoma) for reference. Review each patient before submitting.'|xlt }}
</div>

{% if report.patients is not empty %}
    <table class="table table-sm table-bordered w-auto">
        <thead class="thead-light">
            <tr><th>{{ 'Criteria 1 (Exam for Recurrence)'|xlt }}</th><th>{{ 'Patients'|xlt }}</th><th>{{ 'Criteria 2 (Recurrence, Inverse)'|xlt }}</th><th>{{ 'Patients'|xlt }}</th></tr>
        </thead>
        {% set c1 = report.criteria1Counts|keys %}
        {% set c2 = report.criteria2Counts|keys %}
        {% for i in 0..(max(c1|length, c2|length) - 1) %}
            <tr>
                <td>{{ (c1[i] ?? '')|text }}</td>
                <td>{{ (c1[i] is defined ? report.criteria1Counts[c1[i]] : '')|text }}</td>
                <td>{{ (c2[i] ?? '')|text }}</td>
                <td>{{ (c2[i] is defined ? report.criteria2Counts[c2[i]] : '')|text }}</td>
            </tr>
        {% endfor %}
    </table>
{% endif %}

<h5 class="mt-4">{{ 'Measure Tracking by Patient'|xlt }}</h5>
{% if report.patients is not empty %}
    <table class="table table-sm table-bordered table-striped">
        <thead class="thead-light">
            <tr>
                <th>{{ 'Patient ID'|xlt }}</th>
                <th>{{ 'Patient Name'|xlt }}</th>
                <th>{{ 'DOB'|xlt }}</th>
                <th>{{ 'Qualifying Visits'|xlt }}</th>
                <th>{{ 'Excision CPTs'|xlt }}</th>
                <th>{{ 'Criteria 1 Codes'|xlt }}</th>
                <th>{{ 'Criteria 1 Status'|xlt }}</th>
                <th>{{ 'Criteria 2 Codes'|xlt }}</th>
                <th>{{ 'Criteria 2 Status'|xlt }}</th>
            </tr>
        </thead>
        {% for patient in report.patients %}
            <tr>
                <td>{{ m.patientLink(patient.pid) }}</td>
                <td>{{ patient.lname|text }}, {{ patient.fname|text }}</td>
                <td>{{ patient.dob|text }}</td>
                <td>{% if patient.inDenominator() %}{{ patient.encounters|length|text }}{% else %}<span class="text-muted">{{ 'None'|xlt }}</span>{% endif %}</td>
                <td class="codes">{{ m.list(patient.excisions) }}</td>
                <td class="codes">{{ m.list(patient.criteria1Codes) }}</td>
                <td>{{ m.status(patient.criteria1Status) }}</td>
                <td class="codes">{{ m.list(patient.criteria2Codes) }}</td>
                <td>{{ m.status(patient.criteria2Status) }}</td>
            </tr>
        {% endfor %}
    </table>
{% else %}
    <p>{{ 'No patients with a melanoma diagnosis in the lookback.'|xlt }}</p>
{% endif %}

<h5 class="mt-4">{{ 'Qualifying Visits'|xlt }} {{ measure.year|text }}</h5>
{% if report.encounterCount() > 0 %}
    <table class="table table-sm table-bordered table-striped">
        <thead class="thead-light">
            <tr>
                <th>{{ 'Patient ID'|xlt }}</th>
                <th>{{ 'Patient Name'|xlt }}</th>
                <th>{{ 'Sex'|xlt }}</th>
                <th>{{ 'DOB'|xlt }}</th>
                <th>{{ 'Age'|xlt }}</th>
                <th>{{ 'Encounter Date'|xlt }}</th>
                <th>{{ 'Encounter ID'|xlt }}</th>
                <th>{{ 'Visit Codes'|xlt }}</th>
                <th>{{ 'Measure Codes on This Fee Sheet'|xlt }}</th>
                <th>{{ 'Melanoma Diagnosis History'|xlt }}</th>
            </tr>
        </thead>
        {% for patient in report.patients %}
            {% for encounter in patient.encounters %}
                <tr>
                    <td>{{ m.patientLink(patient.pid) }}</td>
                    <td>{{ patient.lname|text }}, {{ patient.fname|text }}</td>
                    <td>{{ patient.sex|text }}</td>
                    <td>{{ patient.dob|text }}</td>
                    <td>{{ encounter.age|text }}</td>
                    <td>{{ encounter.date|text }}</td>
                    <td>{{ encounter.encounter|text }}</td>
                    <td>{{ encounter.visitCodes|text }}</td>
                    <td class="codes">{{ m.list(encounter.measureCodes) }}</td>
                    <td>{{ patient.dxHistory|text }}</td>
                </tr>
            {% endfor %}
        {% endfor %}
    </table>
{% else %}
    <p>{{ 'No qualifying visits in the performance year.'|xlt }}</p>
{% endif %}

<div class="alert alert-info mt-4">
    <h6>{{ 'Measure 509 Codes Tracked (2026 specification)'|xlt }}</h6>
    <ul class="mb-2">
        {% for code, label in measureCodes %}
            <li><strong>{{ code|text }}</strong> &mdash; {{ label|text }} ({{ 'performance year'|xlt }})</li>
        {% endfor %}
        <li><strong>{{ 'Excision CPTs'|xlt }}</strong> ({{ 'M1386 reference coding, used in place of M1386'|xlt }}) &mdash; {{ excisionCodes|join(', ')|text }} ({{ lookbackYears|text }}-{{ 'year lookback'|xlt }})</li>
    </ul>
    <p class="mb-0">{{ 'Criteria 1 uses the most advantageous code if more than one is entered (M1388 > M1392 > M1390). Criteria 2 is an inverse measure; M1393 (no recurrence) is the better clinical outcome.'|xlt }}</p>
</div>
</div>
</body>
</html>
